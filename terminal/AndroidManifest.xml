<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="dev.galaxy.terminal">
    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="35" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <application android:label="Galaxy Terminal" android:allowBackup="false" android:extractNativeLibs="true"
        android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher"
        android:networkSecurityConfig="@xml/browser_network"
        android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".TerminalActivity" android:exported="true"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".TerminalActivity$UbuntuActivity" android:exported="false" android:launchMode="singleTop"
            android:enableOnBackInvokedCallback="false"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:windowSoftInputMode="adjustResize|stateAlwaysHidden" />
        <provider android:name=".SharedFileProvider" android:authorities="dev.galaxy.terminal.shared"
            android:exported="false" android:grantUriPermissions="true" />
    </application>
</manifest>
