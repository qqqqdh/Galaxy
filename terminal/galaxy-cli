#!/usr/bin/env bash
set -euo pipefail

die() { printf '%s\n' "$*" >&2; exit 1; }

doctor() {
    local project=${1:-.} tool path version module output sample
    cd -- "$project" || return 1
    export GOTOOLCHAIN=local GOPROXY=off GOSUMDB=off GOFLAGS=-mod=readonly
    printf '프로젝트 · %s\n' "$PWD"
    printf 'Ubuntu · %s\n' "$(uname -m)"
    for tool in go node python3 git java clangd gopls pyright-langserver rust-analyzer jdtls \
        typescript-language-server vscode-html-language-server vscode-css-language-server galaxy-ide galaxy-files galaxy-servers; do
        if ! path=$(command -v "$tool"); then
            printf '  %-27s 설치 안 됨\n' "$tool"
            continue
        fi
        version=
        case "$tool" in
            go|gopls) version=$(timeout 3s "$path" version 2>&1) || version= ;;
            node|python3|git|java|clangd|rust-analyzer|galaxy-ide|galaxy-files|galaxy-servers)
                version=$(timeout 3s "$path" --version 2>&1) || version= ;;
        esac
        printf '  %-27s %s\n' "$tool" "${version%%$'\n'*}"
        printf '    %s\n' "$path"
    done

    command -v go >/dev/null || return 0
    # Diagnose the installed toolchain and existing cache without updating the project.
    if ! module=$(timeout 8s go env GOMOD 2>&1); then
        printf '\n[오류] Go 모듈 검색\n%s\n' "$module" >&2
        return 1
    fi
    if [[ ! -f $module ]]; then
        printf '\nGo 모듈 · 현재 위치에 go.mod 없음\n'
        return 0
    fi
    printf '\nGo 모듈 · %s\n' "$module"
    local result=0
    if output=$(timeout 12s go list ./... 2>&1); then
        printf '  패키지 읽기 · 성공\n'
    else
        printf '  패키지 읽기 · 실패\n%s\n' "$output"
        result=1
    fi
    if command -v gopls >/dev/null; then
        sample=$(find . \( -name .git -o -name vendor -o -name node_modules \) -prune -o -type f -name '*.go' -print -quit)
        if [[ -z $sample ]]; then
            printf '  gopls · 검사할 Go 파일 없음\n'
        elif output=$(timeout 15s gopls check "$sample" 2>&1); then
            printf '  gopls · %s 검사 성공\n' "$sample"
            [[ -z $output ]] || printf '%s\n' "$output"
        else
            printf '  gopls · %s 검사 실패\n%s\n' "$sample" "$output"
            result=1
        fi
    fi
    return "$result"
}

case "${0##*/}" in
    galaxy-open)
        if [[ ${1:-} == --help ]]; then printf '사용법: galaxy-open [폴더]\n'; exit 0; fi
        [[ $# -le 1 ]] || die '사용법: galaxy-open [폴더]'
        command -v galaxy-files >/dev/null || die 'galaxy-files를 먼저 설치하세요.'
        folder=$(realpath -e -- "${1:-.}") || exit 1
        [[ -d $folder ]] || die '폴더를 선택하세요.'
        exec galaxy-files "$folder"
        ;;
    galaxy-share)
        if [[ ${1:-} == --help ]]; then printf '사용법: galaxy-share 파일\n'; exit 0; fi
        [[ $# == 1 && -f $1 ]] || die '공유할 일반 파일을 지정하세요. 사용법: galaxy-share 파일'
        [[ ${GALAXY_ANDROID:-} == 1 && -t 1 ]] || die 'Galaxy Terminal의 Ubuntu 셸에서 실행하세요.'
        umask 077
        transfer=/mnt/galaxy-transfer
        name=${1##*/}
        [[ $name != *[[:cntrl:]]* && $name != *\\* ]] || die '공유할 파일 이름에 사용할 수 없는 문자가 있습니다.'
        find "$transfer" -maxdepth 1 -type f -name '.galaxy-share-*' -mtime +1 -delete 2>/dev/null || true
        stage=$(mktemp "$transfer/.galaxy-share-XXXXXXXXXXXX")
        trap 'rm -f -- "$stage"' EXIT
        cat -- "$1" >"$stage"
        encoded=$(printf '%s' "$name" | base64 -w0)
        printf '\033]778;share;%s;%s\007' "${stage##*/}" "$encoded"
        trap - EXIT
        ;;
    galaxy-doctor)
        if [[ ${1:-} == --help ]]; then printf '사용법: galaxy-doctor [프로젝트 폴더]\n'; exit 0; fi
        [[ $# -le 1 ]] || die '사용법: galaxy-doctor [프로젝트 폴더]'
        doctor "$@"
        ;;
    *) die 'galaxy-open, galaxy-share 또는 galaxy-doctor 이름으로 실행하세요.' ;;
esac
