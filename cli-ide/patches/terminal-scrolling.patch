-		// Remove oldest lines
-		s.lines = s.lines[len(s.lines)-maxLines:]
-	}
+	lines := s.Lines()
+	first := max(0, len(lines)-maxLines)
+	clear(lines[:first])
+	s.lines = lines[first:]
+	s.maxLines, s.oldest = maxLines, 0
 }
 
 // Line returns the line at the given index.
@@ -104,7 +106,7 @@ func (s *Scrollback) Line(index int) uv.Line {
 	if s == nil || index < 0 || index >= len(s.lines) {
 		return nil
 	}
-	return s.lines[index]
+	return s.lines[(s.oldest+index)%len(s.lines)]
 }
 
 // Lines returns all lines in the scrollback buffer.
@@ -113,7 +115,10 @@ func (s *Scrollback) Lines() []uv.Line {
 	if s == nil {
 		return nil
 	}
-	return s.lines
+	if s.oldest == 0 {
+		return s.lines
+	}
+	return slices.Concat(s.lines[s.oldest:], s.lines[:s.oldest])
 }
 
 // Clear removes all lines from the scrollback buffer.
@@ -121,7 +126,9 @@ func (s *Scrollback) Clear() {
 	if s == nil {
 		return
 	}
+	clear(s.lines)
 	s.lines = s.lines[:0]
+	s.oldest = 0
 }
 
